# Local demonstration defaults only. Change these for your own machine.
POSTGRES_DB=aerosense
POSTGRES_USER=aerosense_admin
POSTGRES_PASSWORD=synthetic-admin-local-only
APP_DB_USER=aerosense_app
APP_DB_PASSWORD=synthetic-app-local-only
POSTGRES_PORT=5432

BACKEND_PORT=8080
ANALYTICS_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=jdbc:postgresql://localhost:5432/aerosense
DATABASE_USERNAME=aerosense_app
DATABASE_PASSWORD=synthetic-app-local-only
ANALYTICS_URL=http://localhost:8000
RETRIEVAL_URL=http://localhost:8000

# Optional answer phrasing provider. The app defaults to deterministic local answers.
AEROSENSE_ANSWER_PROVIDER=deterministic
AEROSENSE_LLM_BASE_URL=https://api.openai.com/v1
AEROSENSE_LLM_MODEL=
AEROSENSE_LLM_API_KEY=
AEROSENSE_LLM_TIMEOUT_SECONDS=8
